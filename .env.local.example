# Required for live TBA data (free read key from thebluealliance.com/account)
TBA_API_KEY=

# Required for Gemini vision analysis (free tier from aistudio.google.com)
GEMINI_API_KEY=

# Optional vision settings
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RPM_LIMIT=10

# Public defaults (safe for client-side)
NEXT_PUBLIC_DEFAULT_YEAR=2026
NEXT_PUBLIC_DEFAULT_EVENT=2026cmp
NEXT_PUBLIC_DEFAULT_TEAM=2186
